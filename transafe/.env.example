# Copy to .env (git-ignored) and fill in what you have. Everything is optional.

# Google Maps JavaScript API key (Google Cloud project with billing enabled, "Maps JavaScript API" turned on).
# Restrict the key to your site under "HTTP referrers", e.g. http://127.0.0.1:8000/*
# Without it the dashboard uses Leaflet + OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# Live data. If any of these is set, Transafe runs in live mode (real posts only, no simulator).
# X API v2 bearer token (developer.x.com; billed per post read). Searches BMTC / Namma Metro posts of the last 7 days.
X_BEARER_TOKEN=
X_POLL_SECONDS=900

# Reddit "script" app credentials (reddit.com/prefs/apps; free tier is non-commercial and needs Reddit's approval).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=bangalore,bengaluru
REDDIT_POLL_SECONDS=300
